{
  "name": "@sendsure/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "cf:build": "NEXT_PUBLIC_COMMIT_SHA=$(git rev-parse --short HEAD) opennextjs-cloudflare build",
    "cf:preview": "NEXT_PUBLIC_COMMIT_SHA=$(git rev-parse --short HEAD) opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_PUBLIC_COMMIT_SHA=$(git rev-parse --short HEAD) opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@sendsure/chain": "workspace:*",
    "@sendsure/core": "workspace:*",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.143.0"
  }
}
